{
  "name": "simsim-friends-workspace",
  "private": true,
  "description": "SimSim Friends 저장소. 실제 앱은 apps/ 아래에 있다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayoung-99/simsim-friends.git"
  },
  "homepage": "https://simsim-friends.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w simsim-friends && npm run build -w @simsim-friends/web",
    "build:web": "npm run build -w @simsim-friends/web",
    "test": "npm run test -w simsim-friends",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "app-icon": "npm run app-icon -w simsim-friends",
    "check": "npm run check -w simsim-friends",
    "check:expiry": "npm run check:expiry -w simsim-friends",
    "check:site": "npm run build:web && node scripts/check-site.js",
    "dev": "npm run dev -w simsim-friends",
    "dev:web": "npm run dev -w @simsim-friends/web",
    "dist": "npm run dist -w simsim-friends",
    "preview": "npm run preview -w simsim-friends",
    "site-images": "npm run site-images -w simsim-friends --",
    "start": "npm run start -w simsim-friends",
    "studio": "npm run studio -w simsim-friends",
    "start:both": "npm run start:both -w simsim-friends",
    "start:second": "npm run start:second -w simsim-friends",
    "test:watch": "npm run test:watch -w simsim-friends",
    "tray-icon": "npm run tray-icon -w simsim-friends"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
